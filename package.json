{
  "name": "argos-decisions-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && func start",
    "prestart": "npm run build",
    "start": "func start",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run check:arch && npm run typecheck && npm test"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@azure/service-bus": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
